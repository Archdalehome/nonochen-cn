{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 内销中文站：独立 Worker，不覆盖英文站 `chen-furniture`。
  // 2026-10-27 按用户要求改名：chen-furniture-cn（原 chdn-furniture-cn）。
  "name": "chen-furniture-cn",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      // 中文站独立库，与英文站的 el_store 完全分开。
      "database_name": "el_store_cn",
      // 占位符：CI 每次部署前按库名解析真实 ID 并写回本文件
      // （见 .github/workflows/deploy.yml「解析或创建中文站独立的 D1 库」）。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "el-media"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    // /admin/login signs in with admin/admin out of the box. Replace it without
    // touching the repo (sessions signed with the old password are invalidated):
    //   npx wrangler secret put ADMIN_USER
    //   npx wrangler secret put ADMIN_PASSWORD
    "SITE_NAME": "Chen Furniture",
    "CURRENCY": "GBP",
    "CURRENCY_SYMBOL": "£"
  }
}
